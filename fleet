KIT = f'{FLEET_DIR}/bin/fleetkit'
# Jarvis runs lookups mid-conversation: an unanswered permission prompt shouldn't hold it for 20 s
PROMPT_WAIT = 4 if os.environ.get('FLEET_NO_WAIT') else 20


def osa(script, timeout=None):
    try:
        r = subprocess.run(['osascript', '-e', script], capture_output=True, text=True, timeout=timeout or PROMPT_WAIT)
    except subprocess.TimeoutExpired:
        sys.exit('macOS is waiting for permission: check your Mac for an "allow access" prompt.')
    if r.returncode:
        err = r.stderr.strip()
        if 'Not authorized' in err or '-1743' in err:
            sys.exit('No permission yet: System Settings → Privacy & Security → Automation, allow Fleet to control that app.')
        sys.exit(err or 'osascript failed')
    return r.stdout.strip()


def kit(*args, timeout=None):
    if not os.path.exists(KIT):
        mac_setup(quiet=True)
    try:
        r = subprocess.run([KIT, *args], capture_output=True, text=True, timeout=timeout or PROMPT_WAIT + 2)
    except subprocess.TimeoutExpired:
        sys.exit('macOS is waiting for permission: check your Mac for a Calendars or Reminders prompt.')
    data = json.loads(r.stdout or '{}')
    if isinstance(data, dict) and data.get('error'):
        sys.exit(data['error'])
    return data


def when_range(word):
    import datetime
    today = datetime.date.today()
    if word in ('', 'today'):
        a, b = today, today + datetime.timedelta(days=1)
    elif word == 'tomorrow':
        a, b = today + datetime.timedelta(days=1), today + datetime.timedelta(days=2)
    elif word == 'week':
        a, b = today, today + datetime.timedelta(days=7)
    else:
        try:
            a = datetime.date.fromisoformat(word)
        except ValueError:
            sys.exit(f"Use today, tomorrow, week or a date like 2026-10-30 (not {word!r}).")
        b = a + datetime.timedelta(days=1)
    return a.isoformat(), b.isoformat()


def fmt_time(isotime):
    import datetime
    if not isotime:
        return ''
    t = datetime.datetime.fromisoformat(isotime.replace('Z', '+00:00')).astimezone()
    return t.strftime('%a %-d %b %-I:%M %p')


