def restore(args):
    """Put your ideas and lists back as they were in a daily backup (~/.fleet/backups). Nothing else changes."""
    d = f'{FLEET_DIR}/backups'
    names = sorted((f for f in os.listdir(d) if re.fullmatch(r'fleet-\d{4}-\d\d-\d\d\.db', f)), reverse=True) if os.path.isdir(d) else []
    if not args:
        if not names:
            return print('No backups yet. The dashboard saves one a day in ~/.fleet/backups.')
        for n in names:
            b = sqlite3.connect(f'file:{d}/{n}?mode=ro', uri=True)
            print(f'  {n[6:16]}  {b.execute("SELECT count(*) FROM ideas WHERE done = 0").fetchone()[0]} open ideas')
        return print('fleet restore YYYY-MM-DD puts your ideas and lists back as they were that day (a copy of now is saved first).')
    name = f'fleet-{args[0]}.db'
    if name not in names:
        sys.exit(f'No backup from {args[0]}. fleet restore lists them.')
    con = db()
    keep = f'{d}/before-restore-{time.strftime("%Y-%m-%d-%H%M%S")}.db'
    con.execute('VACUUM INTO ?', (keep,))
    con.execute('ATTACH ? AS b', (f'{d}/{name}',))
    with con:
        for table in ('lists', 'ideas'):
            here = {r[1] for r in con.execute(f'PRAGMA main.table_info({table})')}
            cols = ', '.join(r[1] for r in con.execute(f'PRAGMA b.table_info({table})') if r[1] in here)
            con.execute(f'DELETE FROM main.{table}')
            con.execute(f'INSERT INTO main.{table} ({cols}) SELECT {cols} FROM b.{table}')
        con.execute('INSERT OR IGNORE INTO main.lists (name, position) SELECT DISTINCT list, 100 FROM main.ideas')
    print(f'Ideas and lists are back as they were on {args[0]}. What you had a moment ago is saved as {keep}.')


