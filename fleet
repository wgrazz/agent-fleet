#!/usr/bin/env python3
"""fleet: see, reattach and stop the coding agents (Claude, Codex, Cursor, Copilot, Antigravity) on this machine.

START & RETURN
  fleet new NAME         start a protected session called NAME in this folder, then run claude/codex/agent in it
  fleet new NAME --tool claude|codex|cursor|copilot|agy [--model M] [--effort E] [--profile P] [--detach] [PROMPT]
                         start NAME already running that tool, optionally with a first prompt
  fleet resume [NAME]    go back into NAME (no name: the only session, or a list if there are several)
  fleet peek NAME        print the last 40 lines of NAME's screen without going into it

SEE
  fleet                  the agents you started, their status, what they're doing, and any follow-up waiters
  fleet all              same, plus background helpers (desktop apps, Codex service, chrome bridge, claude-mem)
  fleet json             the same agents as JSON (what the dashboard reads)

LATER
  fleet pause NAME       stop NAME's agent but keep its conversation, to pick up later
  fleet paused           list paused agents
  fleet unpause ID|NAME  bring a paused agent back in a new session with its conversation
  fleet idea [-l LIST] TEXT   jot an idea (lands in Brain Dump unless you name a list)

DASHBOARD
  fleet dash             open the dashboard in your browser
  fleet dash install     run the dashboard at login and put it on your tailnet for your phone (--local: Mac only)
  fleet dash update      after changing the dashboard's code: rebuild the page and restart the server
  fleet dash uninstall   stop it and remove it from login items
  fleet hooks install    let Claude Code report its status to the dashboard instantly (uninstall to undo)

STOP
  fleet kill PID|NAME    stop one agent or waiter (by PID) or a whole session (by NAME)
  fleet kill --all       stop every agent and waiter you started, after a y/N prompt
                         (never touches background helpers or the agent that ran it)

INSIDE A SESSION (tmux keys: press Ctrl-b, let go, then the key)
  Ctrl-b d               leave the session; the agent keeps running (fleet resume to come back)
  Ctrl-b [               scroll mode: arrows/PgUp to scroll, q to exit

WHERE column
  safe · NAME · background   protected, keeps running with no window open
  safe · NAME · on screen    protected, currently open in a window
  dies with window           not protected: closing that window or a Termius drop kills it

Agents only survive a dropped connection when started with `fleet new`. `fleet help` shows this.
"""
import argparse
import glob
import json
import os
import re
import secrets
import shlex
import shutil
import signal
import sqlite3
import subprocess
import sys
import time
import urllib.request

HOME = os.path.expanduser('~')
FLEET = os.path.realpath(__file__)
FLEET_DIR = os.environ.get('FLEET_DIR', f'{HOME}/.fleet')
CLAUDE_SETTINGS = os.environ.get('FLEET_CLAUDE_SETTINGS', f'{HOME}/.claude/settings.json')
NAME_RE = re.compile(r'^[A-Za-z0-9._-]{1,40}$')
# basename of argv[0], or of an argv[1] path (`node /…/codex`) -> tool; `agent` is Cursor's CLI here
TOOLS = {'claude': 'claude', 'codex': 'codex', 'cursor-agent': 'cursor', 'agent': 'cursor',
         'copilot': 'copilot', 'agy': 'agy'}
WAITER = re.compile(r'\buntil\b.*\bsleep\b|codex exec resume')

# How to launch each tool. '{}' is replaced by the value; None means the tool has no such option.
# Flags come from each tool's --help (2026-10-23).
LAUNCH = {
    'claude':  dict(bin='claude', prompt=[], model=['--model', '{}'], effort=['--effort', '{}'], resume=['--resume', '{}']),
    'codex':   dict(bin='codex', prompt=[], model=['-m', '{}'], effort=['-c', 'model_reasoning_effort={}'], resume=['resume', '{}']),
    'cursor':  dict(bin='cursor-agent', prompt=[], model=['--model', '{}'], effort=None, resume=['--resume', '{}']),
    'copilot': dict(bin='copilot', prompt=['-i'], model=['--model', '{}'], effort=None, resume=['--resume={}']),
    'agy':     dict(bin='agy', prompt=['-i'], model=['--model', '{}'], effort=['--effort', '{}'], resume=['--conversation', '{}']),
}
# Test-only tools: FLEET_EXTRA_TOOLS="fake=/abs/fake-agent.sh,other=/abs/x"
for _spec in filter(None, os.environ.get('FLEET_EXTRA_TOOLS', '').split(',')):
    _name, _bin = _spec.split('=', 1)
    LAUNCH[_name] = dict(bin=_bin, prompt=[], model=None, effort=None, resume=None)
    TOOLS[os.path.basename(_bin)] = _name


def out(*cmd):
    return subprocess.run(cmd, capture_output=True, text=True).stdout


def snapshot():
    procs = {}
    for line in out('ps', '-axo', 'pid=,ppid=,etime=,tty=,command=').splitlines():
        pid, ppid, age, tty, cmd = line.split(None, 4)
        procs[int(pid)] = dict(pid=int(pid), ppid=int(ppid), age=age, tty=tty, cmd=cmd)
    return procs


def tool(cmd):
    # ponytail: splits on spaces, fine while agent binaries live in space-free paths
    argv = cmd.split()
    for arg in argv[:1] + [a for a in argv[1:2] if '/' in a]:  # `distnoted agent` is not Cursor
        if os.path.basename(arg) in TOOLS:
            return TOOLS[os.path.basename(arg)]


def ancestors(procs, pid):
    pid = procs[pid]['ppid'] if pid in procs else 0
    while pid in procs and pid > 1:
        yield pid
        pid = procs[pid]['ppid']


def find(procs):
    """Top-level agents and waiters (a match nested under another match is part of its parent)."""
    agents = {p: tool(v['cmd']) for p, v in procs.items() if tool(v['cmd'])}
    waiters = {p for p, v in procs.items() if WAITER.search(v['cmd'])}
    top_agents = [p for p in agents if not any(a in agents for a in ancestors(procs, p))]
    top_waiters = [p for p in waiters if not any(a in waiters for a in ancestors(procs, p))]
    return agents, sorted(top_agents), sorted(top_waiters)


def service(procs, pid):
    """Label for agent processes that belong to an app or tool rather than a session you started."""
    cmd, parent = procs[pid]['cmd'], procs.get(procs[pid]['ppid'], {}).get('cmd', '')
    if '.app/' in cmd or 'app-server' in cmd:
        return 'app/service'
    if '--chrome-native-host' in cmd:
        return 'chrome bridge'
    if 'claude-mem' in parent:
        return 'claude-mem observer'


def panes():
    """pane pid -> (session, attached client count)"""
    res = {}
    for line in out('tmux', 'list-panes', '-a', '-F', '#{pane_pid} #{session_attached} #{session_name}').splitlines():
        pid, attached, name = line.split(' ', 2)
        res[int(pid)] = (name, int(attached))
    return res


def cwds(pids):
    res, pid = {}, None
    if pids:
        for line in out('lsof', '-a', '-d', 'cwd', '-Fn', '-p', ','.join(map(str, pids))).splitlines():
            if line[:1] == 'p':
                pid = int(line[1:])
            elif line[:1] == 'n':
                res[pid] = line[1:]
    return res


def secs(etime):
    days, _, hms = etime.rpartition('-')
    total = 0
    for part in hms.split(':'):
        total = total * 60 + int(part)
    return total + int(days or 0) * 86400


def claude_task(pid):
    """Claude Code writes ~/.claude/sessions/<pid>.json; the session's transcript carries its title."""
    try:
        with open(f'{HOME}/.claude/sessions/{pid}.json') as f:
            meta = json.load(f)
    except (OSError, ValueError):
        return ''
    title = meta.get('name', '')
    for path in glob.glob(f'{HOME}/.claude/projects/*/{meta.get("sessionId")}.jsonl'):
        with open(path, 'rb') as f:
            f.seek(0, 2)
            f.seek(max(0, f.tell() - 2_000_000))  # titles are re-written often; the tail has the latest
            for line in f:
                if b'-title"' in line:
                    try:
                        d = json.loads(line)
                    except ValueError:
                        continue
                    title = d.get('customTitle') or d.get('aiTitle') or title
    return f"[{meta.get('status', '?')}] {title}"


def codex_task(cwd, started_ms):
    # ponytail: Codex doesn't record which process owns a thread, so this picks the newest thread in the
    # same folder touched since the process started; two Codex agents in one folder can show the same task.
    dbs = sorted(glob.glob(f'{HOME}/.codex/state_*.sqlite'))
    if not dbs:
        return ''
    try:
        con = sqlite3.connect(f'file:{dbs[-1]}?mode=ro', uri=True)
        row = con.execute(
            "SELECT coalesce(nullif(name, ''), nullif(title, ''), first_user_message) FROM threads"
            " WHERE cwd = ? AND archived = 0 AND updated_at_ms >= ? ORDER BY updated_at_ms DESC LIMIT 1",
            (cwd, started_ms)).fetchone()
    except sqlite3.Error:
        return ''
    return row[0] if row else '(no prompt yet)'


def newest_since(pattern, started_s, strip=''):
    # ponytail: these tools don't record which process owns a session, so this takes the newest one touched since the
    # process started; two agents of the same tool started together can resolve to the same id.
    hits = [(os.path.getmtime(p), p) for p in glob.glob(pattern) if os.path.getmtime(p) >= started_s]
    return os.path.basename(max(hits)[1]).removesuffix(strip) if hits else ''


def session_id(tool_name, pid, cwd, started_s):
    """The id each tool's own resume flag takes, or '' when it can't be found."""
    if tool_name == 'claude':
        try:
            with open(f'{HOME}/.claude/sessions/{pid}.json') as f:
                return json.load(f).get('sessionId', '')
        except (OSError, ValueError):
            return ''
    if tool_name == 'codex':
        dbs = sorted(glob.glob(f'{HOME}/.codex/state_*.sqlite'))
        try:
            row = dbs and sqlite3.connect(f'file:{dbs[-1]}?mode=ro', uri=True).execute(
                'SELECT id FROM threads WHERE cwd = ? AND archived = 0 AND updated_at_ms >= ?'
                ' ORDER BY updated_at_ms DESC LIMIT 1', (cwd, int(started_s * 1000))).fetchone()
        except sqlite3.Error:
            return ''
        return row[0] if row else ''
    if tool_name == 'cursor':
        return newest_since(f'{HOME}/.cursor/chats/*/*', started_s)
    if tool_name == 'copilot':
        return newest_since(f'{HOME}/.copilot/session-state/*', started_s)
    if tool_name == 'agy':
        return newest_since(f'{HOME}/.gemini/antigravity-cli/conversations/*.db', started_s, '.db')
    return ''


def task(procs, pid, tool_name, cwd):
    if service(procs, pid) in ('app/service', 'chrome bridge'):  # services host many threads; a guess would mislead
        return ''
    if tool_name == 'claude':
        return claude_task(pid)
    if tool_name == 'codex' and cwd:
        return codex_task(cwd, int((time.time() - secs(procs[pid]['age'])) * 1000))
    return ''


def pane_of(procs, pid, pane_map):
    return next((pane_map[a] for a in [pid, *ancestors(procs, pid)] if a in pane_map), None)


def where(procs, pid, pane_map):
    if service(procs, pid):
        return service(procs, pid)
    pane = pane_of(procs, pid, pane_map)
    if pane:
        return f"safe · {pane[0]} · {'on screen' if pane[1] else 'background'}"
    return 'dies with window'


def owner(procs, pid, agents):
    return next((f'{agents[a]} {a}' for a in ancestors(procs, pid) if a in agents), 'detached')


def rows(procs, everything=False):
    """One dict per top-level agent; feeds both the table and `fleet json`."""
    agents, top, _ = find(procs)
    top = top if everything else [p for p in top if not service(procs, p)]
    pane_map, dirs, mine = panes(), cwds(top), set(ancestors(procs, os.getpid()))
    res = []
    for p in top:
        cwd, age_s, pane = dirs.get(p, ''), secs(procs[p]['age']), pane_of(procs, p, pane_map)
        res.append(dict(pid=p, tool=agents[p], age=procs[p]['age'], age_s=age_s, cwd=cwd,
                        session=pane[0] if pane else None, where=where(procs, p, pane_map),
                        task=task(procs, p, agents[p], cwd).replace('\n', ' '),
                        session_id=session_id(agents[p], p, cwd, time.time() - age_s),
                        service=service(procs, p), mine=p in mine))
    return res


def config():
    """~/.fleet/config.json: the dashboard's port and access key (created on first use, readable only by you)."""
    path = f'{FLEET_DIR}/config.json'
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        os.makedirs(FLEET_DIR, mode=0o700, exist_ok=True)
        cfg = {'port': 7878, 'key': secrets.token_hex(24)}
        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        with os.fdopen(fd, 'w') as f:
            json.dump(cfg, f)
        return cfg


def api(method, path, body=None, timeout=2.0):
    cfg = config()
    req = urllib.request.Request(f'http://127.0.0.1:{cfg["port"]}{path}', method=method,
                                 data=None if body is None else json.dumps(body).encode(),
                                 headers={'X-Fleet-Key': cfg['key'], 'Content-Type': 'application/json'})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return json.loads(r.read() or 'null')


def statuses():
    # ponytail: status lives in the dashboard server; without it the column shows '–'
    try:
        return {a['pid']: a['status'] for a in api('GET', '/api/agents', timeout=0.3)}
    except Exception:
        return {}


def show(procs, everything=False):
    agents, top, waiters = find(procs)
    hidden = [p for p in top if service(procs, p)]
    listed, status = rows(procs, everything), statuses()
    print(f'{"PID":>6}  {"TOOL":<8}{"STATUS":<10}{"AGE":>11}  {"WHERE":<30}{"DIR":<16}TASK')
    for r in listed:
        label = os.path.basename(r['cwd']) or r['cwd'] or '?'
        what = r['task'][:60] + ('  <- ran fleet' if r['mine'] else '')
        st = (status.get(r['pid']) or '–').replace('_', ' ')
        print(f'{r["pid"]:>6}  {r["tool"]:<8}{st:<10}{r["age"]:>11}  {r["where"]:<30}{label[:15]:<16}{what}')
    if not listed:
        print('  (no agents running)')
    if hidden and not everything:
        print(f'  + {len(hidden)} background helpers (fleet all)')
    if waiters:
        print(f'\nWAITERS\n{"PID":>6}  {"OWNER":<14}{"AGE":>12}  COMMAND')
        for p in waiters:
            print(f'{p:>6}  {owner(procs, p, agents):<14}{procs[p]["age"]:>12}  {procs[p]["cmd"][:90]}')


def kill_tree(procs, pid):
    for child in [c for c, v in procs.items() if v['ppid'] == pid]:
        kill_tree(procs, child)
    try:
        os.kill(pid, signal.SIGTERM)
    except ProcessLookupError:
        pass


def kill(procs, target):
    agents, top, waiters = find(procs)
    if target == '--all':
        mine = set(ancestors(procs, os.getpid()))
        doomed = [p for p in top + waiters if p not in mine and not service(procs, p)]
        if not doomed:
            return print('Nothing to kill.')
        for p in doomed:
            print(f'{p:>6}  {agents.get(p, "waiter"):<7}{procs[p]["cmd"][:80]}')
        if input(f'Kill these {len(doomed)}? [y/N] ').strip().lower() != 'y':
            return print('Cancelled.')
        for p in doomed:
            kill_tree(procs, p)
        return print(f'Sent SIGTERM to {len(doomed)}.')
    if target.isdigit():
        pid = int(target)
        if pid not in agents and pid not in waiters:
            sys.exit(f'{pid} is not an agent or waiter (see `fleet`).')
        kill_tree(procs, pid)
        return print(f'Sent SIGTERM to {pid} and its children.')
    if subprocess.run(['tmux', 'kill-session', '-t', f'={target}'], capture_output=True).returncode:
        sys.exit(f'No tmux session named {target}.')
    print(f'Killed tmux session {target}.')


def has_session(name):
    return not subprocess.run(['tmux', 'has-session', '-t', f'={name}'], capture_output=True).returncode


def attach(name):
    verb = 'switch-client' if os.environ.get('TMUX') else 'attach-session'
    os.execvp('tmux', ['tmux', verb, '-t', f'={name}'])


def start(name, cwd, argv=None):
    """New detached session NAME in CWD: a plain shell, or ARGV run through a login shell (for PATH).
    With ARGV the pane stays after the agent exits so the dashboard can read the exit code."""
    # caffeinate keeps the Mac from idle/system sleep (system sleep only on AC power) while the session lives
    shell = os.environ.get('SHELL', '/bin/zsh')
    keepawake = ['caffeinate', '-ims'] if shutil.which('caffeinate') else []  # macOS only; Linux just gets the shell
    cmd = [shell, '-lic', shlex.join(argv)] if argv else [shell]
    remain = [';', 'set-option', '-w', '-t', f'={name}:', 'remain-on-exit', 'on'] if argv else []
    subprocess.run(['tmux', 'new-session', '-d', '-s', name, '-c', cwd, *keepawake, *cmd, *remain], check=True)


def open_session(name):
    if not has_session(name):
        start(name, os.getcwd())
    attach(name)


def db():
    os.makedirs(FLEET_DIR, mode=0o700, exist_ok=True)
    con = sqlite3.connect(f'{FLEET_DIR}/fleet.db')
    con.row_factory = sqlite3.Row
    con.execute('PRAGMA journal_mode=WAL')
    with open(os.path.join(os.path.dirname(FLEET), 'schema.sql')) as f:
        con.executescript(f.read())
    return con


def launch_argv(tool_name, prompt='', model='', effort='', resume='', extra=''):
    spec = LAUNCH.get(tool_name)
    if not spec:
        sys.exit(f'Unknown tool {tool_name!r}. Tools: {", ".join(LAUNCH)}.')
    argv = [spec['bin']]
    for value, key in ((resume, 'resume'), (model, 'model'), (effort, 'effort')):
        if value and spec[key] is None:
            sys.exit(f'{tool_name} has no {key} option.')
        if value:
            argv += [part.replace('{}', value) for part in spec[key]]
    argv += shlex.split(extra or '')
    if prompt:
        argv += [*spec['prompt'], prompt]
    return argv


def check_name(name):
    if not NAME_RE.match(name):
        sys.exit(f'Bad name {name!r}: use letters, digits, . _ - (up to 40).')
    if has_session(name):
        sys.exit(f'A session named {name} already exists (fleet resume {name}).')


def new(args):
    p = argparse.ArgumentParser(prog='fleet new')
    p.add_argument('name')
    p.add_argument('--tool')
    p.add_argument('--profile')
    p.add_argument('--model', default='')
    p.add_argument('--effort', default='')
    p.add_argument('--detach', action='store_true')
    p.add_argument('prompt', nargs='*')
    a = p.parse_args(args)
    if not a.tool and not a.profile:
        if a.detach:
            check_name(a.name)
            return start(a.name, os.getcwd())
        return open_session(a.name)
    check_name(a.name)
    prof = {}
    if a.profile:
        prof = db().execute('SELECT * FROM profiles WHERE name = ?', (a.profile,)).fetchone()
        if not prof:
            sys.exit(f'No profile named {a.profile}.')
    argv = launch_argv(a.tool or prof['tool'], ' '.join(a.prompt), a.model or (prof and prof['model']) or '',
                       a.effort or (prof and prof['effort']) or '', extra=(prof and prof['args']) or '')
    start(a.name, os.getcwd(), argv)
    if a.detach:
        return print(f'Started {a.name}.')
    attach(a.name)


def pause(name):
    row = next((r for r in rows(snapshot()) if r['session'] == name), None)
    if not row:
        sys.exit(f'No agent running in a session named {name}.')
    if not row['session_id']:
        sys.exit(f"Can't pause {name}: no resumable session id found for {row['tool']}.")
    con = db()
    with con:
        con.execute('INSERT INTO paused (name, tool, session_id, cwd, paused_at) VALUES (?, ?, ?, ?, ?)',
                    (name, row['tool'], row['session_id'], row['cwd'] or HOME, int(time.time())))
    subprocess.run(['tmux', 'kill-session', '-t', f'={name}'], capture_output=True)
    print(f'Paused {name}. fleet unpause {name} brings it back.')


def paused_list():
    found = db().execute('SELECT * FROM paused ORDER BY paused_at DESC').fetchall()
    for r in found:
        when = time.strftime('%b %d %H:%M', time.localtime(r['paused_at']))
        print(f'{r["id"]:>4}  {r["name"]:<24}{r["tool"]:<9}{when:<14}{r["cwd"]}')
    if not found:
        print('  (nothing paused)')


def unpause(target, detach=False):
    con = db()
    row = con.execute('SELECT * FROM paused WHERE id = ? OR name = ? ORDER BY paused_at DESC LIMIT 1',
                      (int(target) if target.isdigit() else -1, target)).fetchone()
    if not row:
        sys.exit(f'Nothing paused matches {target} (fleet paused).')
    check_name(row['name'])
    start(row['name'], row['cwd'], launch_argv(row['tool'], resume=row['session_id']))
    with con:
        con.execute('DELETE FROM paused WHERE id = ?', (row['id'],))
    if detach:
        return print(f'Resumed {row["name"]}.')
    attach(row['name'])


def idea(args):
    lst = 'Brain Dump'
    if args[:1] == ['-l'] and len(args) > 1:
        lst, args = args[1], args[2:]
    text = ' '.join(args).strip()
    if not text:
        sys.exit('fleet idea [-l LIST] TEXT')
    con = db()
    with con:
        con.execute('INSERT INTO ideas (list, text, created_at) VALUES (?, ?, ?)', (lst, text, int(time.time())))
    print(f'Added to {lst}.')


def hook(event):
    """Called by Claude Code hooks. Forwards the hook JSON to the dashboard; never fails, never prints."""
    try:
        body = json.loads(sys.stdin.read() or '{}')
        body.update(event=event, tmux_pane=os.environ.get('TMUX_PANE'))
        api('POST', '/api/hook', body)
    except BaseException:
        pass
    os._exit(0)


HOOK_EVENTS = {'UserPromptSubmit': 'working', 'PreToolUse': 'working', 'Notification': 'notify',
               'Stop': 'done', 'SessionEnd': 'end'}


def is_fleet_hook(h):
    return re.search(r'fleet["\']? hook ', h.get('command', '')) is not None


def hooks(action, path=None):
    path = path or CLAUDE_SETTINGS
    try:
        with open(path) as f:
            settings = json.load(f)
    except FileNotFoundError:
        settings = {}
    groups = settings.setdefault('hooks', {})
    changed = 0
    for ev, arg in HOOK_EVENTS.items():
        lst = groups.setdefault(ev, [])
        mine = [g for g in lst if any(is_fleet_hook(h) for h in g.get('hooks', []))]
        if action == 'install' and not mine:
            lst.append({'hooks': [{'type': 'command', 'command': f'{shlex.quote(FLEET)} hook {arg}',
                                   'timeout': 5, 'async': True}]})
            changed += 1
        if action == 'uninstall' and mine:
            for g in mine:
                g['hooks'] = [h for h in g['hooks'] if not is_fleet_hook(h)]
            lst[:] = [g for g in lst if g.get('hooks')]
            changed += 1
        if not lst:
            del groups[ev]
    if not groups:
        del settings['hooks']
    if changed:
        if os.path.exists(path):
            shutil.copy2(path, path + '.fleet-bak')
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path + '.tmp', 'w') as f:
            json.dump(settings, f, indent=2)
            f.write('\n')
        os.replace(path + '.tmp', path)
    verb = 'Installed' if action == 'install' else 'Removed'
    print(f'{verb} {changed} Claude Code hook(s) in {path}.' if changed else 'Nothing to change.')


def dash():
    cfg = config()
    url = f'http://127.0.0.1:{cfg["port"]}/?key={cfg["key"]}'
    if shutil.which('open'):
        subprocess.run(['open', url])
    else:
        print(url)


LABEL = 'com.wgrazz.fleet-dashboard'
PLIST = f'{HOME}/Library/LaunchAgents/{LABEL}.plist'


def tailscale():
    app = '/Applications/Tailscale.app/Contents/MacOS/Tailscale'
    return shutil.which('tailscale') or (app if os.path.exists(app) else None)


def dash_install(local=False):
    """Run the dashboard server at login (launchd) and publish it to your tailnet over HTTPS (tailscale serve)."""
    import plistlib
    dash_dir = os.path.join(os.path.dirname(FLEET), 'dashboard')
    node = shutil.which('node') or sys.exit('The dashboard needs Node.js 24+ (brew install node).')
    if not os.path.isdir(f'{dash_dir}/node_modules'):
        subprocess.run(['npm', 'ci'], cwd=dash_dir, check=True)
    if not os.path.exists(f'{dash_dir}/dist/index.html'):
        subprocess.run(['npm', 'run', 'build'], cwd=dash_dir, check=True)
    cfg = config()
    env = {'PATH': f'{os.path.dirname(node)}:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:{HOME}/.local/bin'}
    if 'FLEET_DIR' in os.environ:
        env['FLEET_DIR'] = FLEET_DIR
    os.makedirs(os.path.dirname(PLIST), exist_ok=True)
    with open(PLIST, 'wb') as f:
        plistlib.dump({'Label': LABEL, 'ProgramArguments': [node, f'{dash_dir}/server/index.ts'], 'WorkingDirectory': dash_dir,
                       'RunAtLoad': True, 'KeepAlive': True, 'EnvironmentVariables': env,
                       'StandardOutPath': f'{FLEET_DIR}/server.log', 'StandardErrorPath': f'{FLEET_DIR}/server.log'}, f)
    domain = f'gui/{os.getuid()}'
    subprocess.run(['launchctl', 'bootout', f'{domain}/{LABEL}'], capture_output=True)  # restart if already loaded
    subprocess.run(['launchctl', 'bootstrap', domain, PLIST], check=True)
    print(f'Dashboard running at login: http://127.0.0.1:{cfg["port"]}/?key={cfg["key"]}')
    ts = None if local else tailscale()
    if not ts:
        return print('Not published to Tailscale (--local, or Tailscale not found).' if local or not tailscale() else '')
    current = json.loads(out(ts, 'serve', 'status', '--json') or '{}')
    if current and f'127.0.0.1:{cfg["port"]}' not in json.dumps(current):
        return print('Tailscale serve already has another config, so it was left alone.\n'
                     f'Publish the dashboard yourself, e.g.: tailscale serve --bg --https=8443 {cfg["port"]}')
    if subprocess.run([ts, 'serve', '--bg', str(cfg['port'])]).returncode:
        return print('tailscale serve failed. If it mentions HTTPS, enable HTTPS certificates in the Tailscale admin '
                     'console (DNS page), then run fleet dash install again.')
    host = json.loads(out(ts, 'status', '--json'))['Self']['DNSName'].rstrip('.')
    print(f'On your phone (Safari → Share → Add to Home Screen): https://{host}/?key={cfg["key"]}')


def dash_update():
    """After code changes: reinstall packages if the lockfile changed, rebuild the page, restart the server."""
    dash_dir = os.path.join(os.path.dirname(FLEET), 'dashboard')
    lock, installed = f'{dash_dir}/package-lock.json', f'{dash_dir}/node_modules/.package-lock.json'
    if not os.path.exists(installed) or os.path.getmtime(lock) > os.path.getmtime(installed):
        subprocess.run(['npm', 'ci'], cwd=dash_dir, check=True)
    subprocess.run(['npm', 'run', 'build', '--silent'], cwd=dash_dir, check=True, stdout=subprocess.DEVNULL)
    if subprocess.run(['launchctl', 'kickstart', '-k', f'gui/{os.getuid()}/{LABEL}'], capture_output=True).returncode:
        sys.exit('Page rebuilt, but the dashboard server is not installed (fleet dash install).')
    print('Updated and restarted. On your phone, swipe Fleet away and reopen it.')


def dash_uninstall():
    subprocess.run(['launchctl', 'bootout', f'gui/{os.getuid()}/{LABEL}'], capture_output=True)
    if os.path.exists(PLIST):
        os.remove(PLIST)
    ts, port = tailscale(), config()['port']
    if ts and f'127.0.0.1:{port}' in out(ts, 'serve', 'status', '--json'):
        subprocess.run([ts, 'serve', '--https=443', 'off'], capture_output=True)
    print('Dashboard stopped and removed from login items.')


