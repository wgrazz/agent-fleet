HOTKEY_LABEL = 'com.wgrazz.fleet-hotkey'


def mac_hotkey(action):
    """⌃⌥Space anywhere on the Mac opens Jarvis, ready to talk."""
    plist = f'{HOME}/Library/LaunchAgents/{HOTKEY_LABEL}.plist'
    domain = f'gui/{os.getuid()}'
    subprocess.run(['launchctl', 'bootout', f'{domain}/{HOTKEY_LABEL}'], capture_output=True)
    if action == 'uninstall':
        if os.path.exists(plist):
            os.remove(plist)
        return print('⌃⌥Space hotkey removed.')
    import plistlib
    src = os.path.join(os.path.dirname(FLEET), 'dashboard', 'mac', 'hotkey.swift')
    binary = f'{FLEET_DIR}/bin/fleet-hotkey'
    os.makedirs(os.path.dirname(binary), exist_ok=True)
    r = subprocess.run(['swiftc', '-O', '-o', binary, src], capture_output=True, text=True)
    if r.returncode:
        sys.exit(f'Could not build the hotkey helper: {r.stderr.strip()[:300]}')
    cfg = config()
    host = ts_host()
    url = f'https://{host}/#/jarvis/talk' if host else f'http://127.0.0.1:{cfg["port"]}/#/jarvis/talk'
    with open(plist, 'wb') as f:
        plistlib.dump({'Label': HOTKEY_LABEL, 'ProgramArguments': [binary, url], 'RunAtLoad': True, 'KeepAlive': True,
                       'StandardErrorPath': f'{FLEET_DIR}/hotkey.log'}, f)
    subprocess.run(['launchctl', 'bootstrap', domain, plist], check=True)
    print('⌃⌥Space now opens Jarvis anywhere on this Mac (starts at login). Add Fleet to your Dock first (fleet dash app) so it opens as its own app.')


def ts_host():
    """This Mac's name on your tailnet (what the phone uses), or '' without Tailscale."""
    ts = tailscale()
    try:
        return json.loads(out(ts, 'status', '--json')).get('Self', {}).get('DNSName', '').rstrip('.') if ts else ''
    except ValueError:  # the app's CLI can't reach its GUI (e.g. from launchd)
        return ''


def siri_shortcut(path, host=''):
    """A signed "Jarvis" shortcut for the iPhone: pause music, dictate, ask Jarvis, play the answer in Jarvis's voice, listen
    again. It ends when Jarvis
    signs off (you said bye, that's all, go away…), when you stop talking, or after 100 turns as a backstop.
    It holds your access key, so it's made on demand and never saved in the repo."""
    import plistlib
    import tempfile
    import uuid
    host = host or ts_host()
    if not host:
        sys.exit('Siri needs the dashboard on your tailnet: install Tailscale, then fleet dash install.')
    said, answer, voice, loop, done = (str(uuid.uuid4()).upper() for _ in range(5))
    text = lambda s: {'Value': {'string': s}, 'WFSerializationType': 'WFTextTokenString'}
    fields = lambda *kv: {'Value': {'WFDictionaryFieldValueItems': [{'WFItemType': 0, 'WFKey': text(k), 'WFValue': v} for k, v in kv]},
                          'WFSerializationType': 'WFDictionaryFieldValue'}
    output = lambda uid, name: {'Value': {'string': '\ufffc', 'attachmentsByRange': {'{0, 1}': {'Type': 'ActionOutput', 'OutputUUID': uid, 'OutputName': name}}},
                                'WFSerializationType': 'WFTextTokenString'}
    key = fields(('X-Fleet-Key', text(config()['key'])))
    step = lambda ident, **p: {'WFWorkflowActionIdentifier': f'is.workflow.actions.{ident}', 'WFWorkflowActionParameters': p}
    workflow = {
        'WFWorkflowActions': [
            step('pausemusic', WFPlayPauseBehavior='Pause'),  # so the mic can hear you
            step('repeat.count', GroupingIdentifier=loop, WFControlFlowMode=0, WFRepeatCount=100),
            step('dictatetext', UUID=said, WFDictateTextStopListening='After Pause'),
            # /api/jarvis/say answers in plain text, so nothing has to pick the reply apart (every link named, none implied)
            step('downloadurl', UUID=answer, WFURL=f'https://{host}/api/jarvis/say', WFHTTPMethod='POST', ShowHeaders=True,
                 WFHTTPHeaders=key, WFHTTPBodyType='JSON', WFJSONValues=fields(('text', output(said, 'Dictated Text')))),
            # in Jarvis's own voice (made on the Mac, like in the app), or Siri's if you chose the device voice
            *([step('speaktext', WFText=output(answer, 'Contents of URL'))] if config().get('voice_engine') == 'device' else [
                step('downloadurl', UUID=voice, WFURL=f'https://{host}/api/tts', WFHTTPMethod='POST', ShowHeaders=True,
                     WFHTTPHeaders=key, WFHTTPBodyType='JSON', WFJSONValues=fields(('text', output(answer, 'Contents of URL')))),
                step('playsound', WFInput={'Value': {'Type': 'ActionOutput', 'OutputUUID': voice, 'OutputName': 'Contents of URL'},
                                           'WFSerializationType': 'WFTextTokenAttachment'}),
            ]),
            # Jarvis ends a goodbye with U+2063 (unspoken): stop listening
            step('conditional', GroupingIdentifier=done, WFControlFlowMode=0, WFCondition=99, WFConditionalActionString='\u2063',
                 WFInput={'Type': 'Variable', 'Variable': {'Value': {'Type': 'ActionOutput', 'OutputUUID': answer, 'OutputName': 'Contents of URL'},
                                                           'WFSerializationType': 'WFTextTokenAttachment'}}),
            step('exit'),
            step('conditional', GroupingIdentifier=done, WFControlFlowMode=2),
            step('repeat.count', GroupingIdentifier=loop, WFControlFlowMode=2),
        ],
        'WFWorkflowClientVersion': '2302.0.4', 'WFWorkflowMinimumClientVersion': 900, 'WFWorkflowMinimumClientVersionString': '900',
        'WFWorkflowIcon': {'WFWorkflowIconStartColor': 463140863, 'WFWorkflowIconGlyphNumber': 59511},
        'WFWorkflowImportQuestions': [], 'WFWorkflowTypes': [], 'WFWorkflowInputContentItemClasses': ['WFStringContentItem'],
        'WFWorkflowOutputContentItemClasses': [], 'WFQuickActionSurfaces': [], 'WFWorkflowHasShortcutInputVariables': False,
    }
    with tempfile.NamedTemporaryFile(suffix='.shortcut') as raw:
        plistlib.dump(workflow, raw, fmt=plistlib.FMT_BINARY)
        raw.flush()
        r = subprocess.run(['shortcuts', 'sign', '--mode', 'anyone', '--input', raw.name, '--output', path], capture_output=True, text=True)
    if r.returncode:
        sys.exit(f'Could not sign the shortcut: {(r.stderr or r.stdout).strip()[:300]}')
    os.chmod(path, 0o600)
    print(path)


