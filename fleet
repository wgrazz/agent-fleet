    assert launch_argv('codex', resume='abc') == ['codex', 'resume', 'abc']
    assert launch_argv('cursor', 'go', 'sonnet') == ['cursor-agent', '--model', 'sonnet', 'go']
    assert launch_argv('copilot', 'go', resume='s1') == ['copilot', '--resume=s1', '-i', 'go']
    assert launch_argv('agy', 'go', effort='max') == ['agy', '--effort', 'max', '-i', 'go']
    assert launch_argv('agy', resume='c1') == ['agy', '--conversation', 'c1']
    assert launch_argv('claude', extra='--add-dir /x') == ['claude', '--add-dir', '/x']
    for bad in (lambda: launch_argv('cursor', effort='high'), lambda: launch_argv('nope')):
        try:
            bad()
            raise AssertionError('expected exit')
        except SystemExit:
            pass
    assert NAME_RE.match('target-px.2_a') and not NAME_RE.match('a b') and not NAME_RE.match('x;rm') \
        and not NAME_RE.match('')

    # hooks install keeps existing hooks, is idempotent, and uninstall restores the original
    import tempfile
    with tempfile.TemporaryDirectory() as d:
        path = f'{d}/settings.json'
        orig = {'model': 'opus', 'hooks': {'Stop': [{'hooks': [{'type': 'command', 'command': 'say done'}]}]}}
        with open(path, 'w') as f:
            json.dump(orig, f)
        sys.stdout, real = open(os.devnull, 'w'), sys.stdout
        try:
            hooks('install', path)
            hooks('install', path)
            with open(path) as f:
                s = json.load(f)
