    assert parse_when('23:59') > time.time() and parse_when('2030-01-02 03:04') > time.time()
    print('ok')


def main(args):
    if not args:
        return show(snapshot())
    if args == ['all']:
        return show(snapshot(), everything=True)
    cmd, rest = args[0], args[1:]
    if cmd == 'json':
        return print(json.dumps(rows(snapshot(), everything=rest == ['all'])))
    if cmd == 'new' and rest:
        return new(rest)
    if cmd in ('resume', 'attach', 'a') and len(rest) == 1:
        return open_session(rest[0])
    if cmd == 'rename' and len(rest) == 2:
        return rename(*rest)
    if cmd == 'pause' and len(rest) == 1:
        return pause(rest[0])
    if cmd == 'pause' and len(rest) == 3 and rest[1] == '--until':
        return pause(rest[0], rest[2])
    if cmd == 'adopt' and rest and rest[0].isdigit():
        names = [a for a in rest[1:] if a != '--force']
        return adopt(int(rest[0]), names[0] if names else None, force='--force' in rest)
    if cmd == 'ask' and rest:
        return ask(' '.join(rest))
    if cmd == 'paused' and not rest:
        return paused_list()
    if cmd == 'unpause' and rest and rest[0] != '--detach':
        return unpause(rest[0], detach='--detach' in rest[1:])
    if cmd == 'idea':
        return idea(rest)
    if cmd == 'checklist':
        return checklist(rest)
    if cmd == 'restore' and len(rest) <= 1:
        return restore(rest)
    if cmd == 'read' and rest:
        return read(rest)
    if cmd == 'import-notes':
        return import_notes(rest)
    if cmd == 'hook' and len(rest) == 1:
        return hook(rest[0])
    if cmd == 'hooks' and rest in (['install'], ['uninstall']):
        return hooks(rest[0])
    if cmd == 'dash' and not rest:
        return dash()
    if cmd == 'dash' and rest[:1] == ['install'] and set(rest[1:]) <= {'--local'}:
        return dash_install(local='--local' in rest)
    if cmd == 'mac' and rest:
        return mac(rest)
    if cmd == 'dash' and rest == ['app']:
        return dash_app()
    if cmd == 'dash' and rest == ['update']:
        return dash_update()
    if cmd == 'dash' and rest[:1] == ['siri'] and len(rest) <= 3:  # siri [FILE] [HOST]
        return siri_shortcut(rest[1] if len(rest) > 1 else os.path.expanduser('~/Desktop/Jarvis.shortcut'), rest[2] if len(rest) > 2 else '')
    if cmd == 'tts' and rest == ['install']:
        return tts_install()
    if cmd == 'dash' and rest == ['uninstall']:
        return dash_uninstall()
    if cmd in ('resume', 'attach', 'a') and not rest:
        names = out('tmux', 'list-sessions', '-F', '#{session_name}').split()
        if len(names) == 1:
            return open_session(names[0])
        sys.exit('Sessions: ' + ', '.join(names) + '\nfleet resume NAME' if names else 'No tmux sessions.')
    if cmd == 'peek' and len(rest) == 1:
        screen = subprocess.run(['tmux', 'capture-pane', '-p', '-t', f'={rest[0]}:', '-S', '-200'],
                                capture_output=True, text=True)
        if screen.returncode:
            sys.exit(f'No tmux session named {rest[0]}.')
        return print('\n'.join(screen.stdout.rstrip().splitlines()[-40:]))
    if cmd in ('help', '-h', '--help'):
        return print(__doc__)
    if cmd == 'kill' and len(rest) == 1:
        return kill(snapshot(), rest[0])
    if cmd == 'selftest':
        return selftest()
    sys.exit(__doc__)


if __name__ == '__main__':
    main(sys.argv[1:])
