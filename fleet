def adopt(pid, name=None, force=False):
    """Move an agent running in a plain terminal window into a protected Fleet session, same conversation."""
    procs = snapshot()
    row = next((r for r in rows(procs) if r['pid'] == pid), None)
    if not row:
        sys.exit(f'No agent with PID {pid} (see fleet).')
    if row['session']:
        sys.exit(f"PID {pid} is already in Fleet as {row['session']}.")
    if not row['session_id'] or LAUNCH.get(row['tool'], {}).get('resume') is None:
        sys.exit(f"Can't move PID {pid} into Fleet: no resumable conversation found for {row['tool']}.")
    if row['task'].startswith('[busy]') and not force:
        sys.exit(f'PID {pid} is in the middle of something. Wait for it to finish, or use --force (it will be interrupted).')
    if not name:
        title = re.sub(r'^\[[a-z]+\]\s*', '', row['task'])
        name = re.sub(r'[^a-z0-9]+', '-', title.lower()).strip('-')[:30] or f"{row['tool']}-{pid}"
        while has_session(name):
            name = f'{name[:34]}-{secrets.token_hex(2)}'
    check_name(name)
    kill_tree(procs, pid)  # the old window shows the agent exited; the conversation carries on in Fleet
    for _ in range(50):
        if pid not in snapshot():
            break
        time.sleep(0.2)
    else:
        sys.exit(f'PID {pid} did not stop, so it was not moved.')
    start(name, row['cwd'] or HOME, launch_argv(row['tool'], resume=row['session_id']))
    print(f'Moved PID {pid} into Fleet as {name}.')


