def checklist(args):
    """Make (or add to) a checklist: steps from stdin, one per line. '- [x]' steps come in checked; '#' lines are headings."""
    title = ' '.join(args).strip()[:60]
    if not title or sys.stdin.isatty():
        sys.exit("fleet checklist TITLE < steps.md   (one step per line; '## ' lines are headings)")
    steps = []
    for line in sys.stdin.read().splitlines():
        line = line.strip()
        heading = re.match(r'^#+\s*(.+)', line)
        if heading:
            steps.append(('## ' + heading.group(1), False))
        elif line:
            done = re.match(r'^[-*+]\s*\[[xX]\]', line) is not None
            steps.append((re.sub(r'^(?:[-*+]\s*(?:\[[ xX]\]\s*)?|\d+[.)]\s+)', '', line), done))
    if not steps:
        sys.exit('No steps on stdin.')
    con = db()
    now = int(time.time())
    with con:
        con.execute("INSERT OR IGNORE INTO lists (name, position, kind) VALUES (?, 100, 'checklist')", (title,))
        start = con.execute('SELECT coalesce(max(position), 0) FROM ideas WHERE list = ?', (title,)).fetchone()[0]
        for n, (text, done) in enumerate(steps, 1):
            con.execute('INSERT INTO ideas (list, text, created_at, position, done, done_at) VALUES (?, ?, ?, ?, ?, ?)',
                        (title, text, now, start + n, int(done), now if done else None))
    print(f"Checklist '{title}': {sum(1 for t, _ in steps if not t.startswith('## '))} steps.")


