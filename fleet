    for bad in (lambda: launch_argv('cursor', effort='high'), lambda: launch_argv('nope')):
        try:
            bad()
            raise AssertionError('expected exit')
        except SystemExit:
            pass
    assert NAME_RE.match('target-px.2_a') and not NAME_RE.match('a b') and not NAME_RE.match('x;rm') \
        and not NAME_RE.match('')

    # hooks install keeps existing hooks, is idempotent, and uninstall restores the original
    import tempfile
    with tempfile.TemporaryDirectory() as d:
        path = f'{d}/settings.json'
        orig = {'model': 'opus', 'hooks': {'Stop': [{'hooks': [{'type': 'command', 'command': 'say done'}]}]}}
        with open(path, 'w') as f:
            json.dump(orig, f)
        sys.stdout, real = open(os.devnull, 'w'), sys.stdout
        try:
            hooks('install', path)
            hooks('install', path)
            with open(path) as f:
                s = json.load(f)
            hooks('uninstall', path)
        finally:
            sys.stdout = real
        assert s['model'] == 'opus' and len(s['hooks']) == 5, s
        assert len(s['hooks']['Stop']) == 2 and s['hooks']['Stop'][0]['hooks'][0]['command'] == 'say done'
        assert s['hooks']['PreToolUse'][0]['hooks'][0]['async'] is True
        with open(path) as f:
            assert json.load(f) == orig
    # Apple Notes parsing, on a note built in the same layout Notes stores
    import gzip

    def enc_varint(n):
        out = b''
        while True:
            out += bytes([(n & 0x7F) | (0x80 if n > 0x7F else 0)])
            n >>= 7
            if not n:
                return out

    def fld(num, val):
        if isinstance(val, int):
            return enc_varint(num << 3) + enc_varint(val)
        return enc_varint(num << 3 | 2) + enc_varint(len(val)) + val

    def run(n, style=None, done=None):
        para = b'' if style is None else fld(1, style) + (fld(5, fld(1, b'u') + fld(2, done)) if done is not None else b'')
        return fld(5, fld(1, n) + (fld(2, para) if style is not None else b''))
    lines = ['000 Brain Dump:', 'Fix login 🙂', 'Ship it', 'plain line']
    text = '\n'.join(lines) + '\n'
    u16 = [len((ln + '\n').encode('utf-16-le')) // 2 for ln in lines]
    note = fld(2, text.encode()) + run(u16[0]) + run(u16[1], CHECKLIST, 0) + run(u16[2], CHECKLIST, 1) + run(u16[3])
    blob = gzip.compress(fld(2, fld(3, note)))
    assert note_lines(blob) == [('000 Brain Dump:', False, False), ('Fix login 🙂', True, False), ('Ship it', True, True),
                                ('plain line', False, False)], note_lines(blob)
    assert notes_list_name('000 Brain Dump:') == 'Brain Dump' and notes_list_name('001 PRIORITY:') == 'Priority'
    assert notes_list_name('011 Side Projects') == 'Side Projects'
    t = parse_when('+2h')
