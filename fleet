                'next_due': 'INTEGER', 'agent': 'TEXT', 'source': 'TEXT', 'suggestion': 'TEXT', 'suggestion_conf': 'REAL',
                'priority': 'INTEGER NOT NULL DEFAULT 0', 'why': 'TEXT'}
NOTES_DB = f'{HOME}/Library/Group Containers/group.com.apple.notes/NoteStore.sqlite'
CHECKLIST = 103  # Apple Notes paragraph style for a checklist line


def pb_fields(buf):
    """Minimal protobuf reader: yields (field number, value) with varints as int and length-delimited as bytes."""
    i = 0

    def varint():
        nonlocal i
        shift = result = 0
        while True:
            b = buf[i]
            i += 1
            result |= (b & 0x7F) << shift
            if b < 0x80:
                return result
            shift += 7
    while i < len(buf):
        key = varint()
        num, wire = key >> 3, key & 7
        if wire == 0:
            yield num, varint()
        elif wire == 2:
            n = varint()
            yield num, buf[i:i + n]
            i += n
        elif wire in (1, 5):
            i += 8 if wire == 1 else 4
        else:
            raise ValueError(f'unsupported protobuf wire type {wire}')


def pb_first(buf, num):
    return next((v for n, v in pb_fields(buf) if n == num), None)


def note_lines(data):
    """Lines of one note from ZICNOTEDATA.ZDATA (gzipped NoteStoreProto) as (text, is_checklist, done).
    Layout (per apple_cloud_notes_parser): proto.2 document → .3 note → .2 text, .5 attribute runs; a run is
    .1 length in UTF-16 units and .2 paragraph style, whose .1 is the style type and .5.2 the checklist done flag."""
    import gzip
    note = pb_first(pb_first(gzip.decompress(data), 2), 3)
    text = pb_first(note, 2).decode('utf-8')
    units = text.encode('utf-16-le')
    lines, cur, style, pos = [], '', (False, False), 0
    for num, run in pb_fields(note):
        if num != 5:
            continue
        length = pb_first(run, 1) or 0
        para = pb_first(run, 2)
        kind = pb_first(para, 1) if para else None
        check = pb_first(para, 5) if para else None
        run_style = (kind == CHECKLIST, bool(check and pb_first(check, 2)))
        for ch in units[pos * 2:(pos + length) * 2].decode('utf-16-le'):
            if ch == '\n':
                lines.append((cur, *(run_style if run_style[0] else style)))
                cur, style = '', (False, False)
            else:
                cur += ch
                style = run_style if run_style[0] else style
        pos += length
    if cur:
        lines.append((cur, *style))
    return lines


def notes_list_name(title):
    """'000 Brain Dump:' → 'Brain Dump', '001 PRIORITY:' → 'Priority', '002 General Code:' → 'General Code'."""
    name = re.sub(r'^\d+\s*', '', title).strip().rstrip(':').strip()
    return 'Priority' if name.lower() == 'priority' else name


def import_notes(args):
    """Copy Apple Notes checklists into Ideas: one list per note, checked items land in that list's Done."""
    dry = '--dry-run' in args
    pattern = re.compile(next((a.split('=', 1)[1] for a in args if a.startswith('--match=')), r'^\d{3}\b'))
    try:
        src = sqlite3.connect(f'file:{NOTES_DB}?mode=ro', uri=True)
        rows = src.execute(
            'SELECT o.ZTITLE1, o.ZIDENTIFIER, d.ZDATA FROM ZICCLOUDSYNCINGOBJECT o JOIN ZICNOTEDATA d ON d.ZNOTE = o.Z_PK'
            ' WHERE o.ZTITLE1 IS NOT NULL AND coalesce(o.ZMARKEDFORDELETION, 0) = 0 AND d.ZDATA IS NOT NULL').fetchall()
    except sqlite3.Error as e:
        sys.exit("Can't read Apple Notes (" + str(e) + ').\nmacOS only lets apps with Full Disk Access read it: System Settings → '
                 'Privacy & Security → Full Disk Access → turn on the terminal app you run this from, then run it again.')
    picked = sorted((r for r in rows if pattern.search(r[0])), key=lambda r: r[0])
    con = None if dry else db()
    total = {'open': 0, 'done': 0, 'skipped': 0}
    for pos, (title, ident, data) in enumerate(picked):
        name = notes_list_name(title)
        try:
            lines = note_lines(data)
        except Exception as e:  # an unexpected note format shouldn't stop the rest
            print(f'  {title}: could not read ({e})')
            continue
        items = [(t.strip(), chk, done) for t, chk, done in lines[1:] if t.strip()]  # line 0 is the title
        opened = sum(1 for _, _, d in items if not d)
        print(f'  {name:<28} {opened:>4} open  {len(items) - opened:>4} done')
        total['open'] += opened
        total['done'] += len(items) - opened
        if dry:
            continue
        with con:
            if name != 'Brain Dump':
                con.execute('INSERT OR IGNORE INTO lists (name, position) VALUES (?, ?)', (name, pos))
            for i, (text, _, done) in enumerate(items):
                source = f'notes:{ident}:{i}:{text[:40]}'
                if con.execute('SELECT 1 FROM ideas WHERE source = ?', (source,)).fetchone():
                    total['skipped'] += 1
                    continue
                now = int(time.time())
                con.execute('INSERT INTO ideas (list, text, created_at, position, source, done, done_at, notes)'
                            " VALUES (?, ?, ?, ?, ?, ?, ?, '')", (name, text, now, i + 1, source, int(done), now if done else None))
    verb = 'Would import' if dry else 'Imported'
    print(f"{verb} {total['open']} open and {total['done']} done items from {len(picked)} notes"
          + (f" ({total['skipped']} already imported)" if total['skipped'] else '') + '. Apple Notes was not changed.')


HOOK_EVENTS = {'UserPromptSubmit': 'working', 'PreToolUse': 'working', 'Notification': 'notify',
               'Stop': 'done', 'SessionEnd': 'end'}


def is_fleet_hook(h):
    return re.search(r'fleet["\']? hook ', h.get('command', '')) is not None


def hooks(action, path=None):
    path = path or CLAUDE_SETTINGS
    try:
        with open(path) as f:
            settings = json.load(f)
    except FileNotFoundError:
        settings = {}
    groups = settings.setdefault('hooks', {})
    changed = 0
    for ev, arg in HOOK_EVENTS.items():
        lst = groups.setdefault(ev, [])
        mine = [g for g in lst if any(is_fleet_hook(h) for h in g.get('hooks', []))]
        if action == 'install' and not mine:
            lst.append({'hooks': [{'type': 'command', 'command': f'{shlex.quote(FLEET)} hook {arg}',
                                   'timeout': 5, 'async': True}]})
            changed += 1
        if action == 'uninstall' and mine:
            for g in mine:
                g['hooks'] = [h for h in g['hooks'] if not is_fleet_hook(h)]
            lst[:] = [g for g in lst if g.get('hooks')]
            changed += 1
        if not lst:
            del groups[ev]
    if not groups:
        del settings['hooks']
    if changed:
        if os.path.exists(path):
            shutil.copy2(path, path + '.fleet-bak')
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path + '.tmp', 'w') as f:
            json.dump(settings, f, indent=2)
            f.write('\n')
        os.replace(path + '.tmp', path)
    verb = 'Installed' if action == 'install' else 'Removed'
    print(f'{verb} {changed} Claude Code hook(s) in {path}.' if changed else 'Nothing to change.')


