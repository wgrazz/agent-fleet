def tts_install():
    """Natural voice for Jarvis: Kokoro (open-weight, Apache-2.0) in its own Python env under ~/.fleet/tts (~350 MB)."""
    d = f'{FLEET_DIR}/tts'
    os.makedirs(d, exist_ok=True)
    uv = shutil.which('uv') or sys.exit('Needs uv (brew install uv).')
    if not os.path.exists(f'{d}/venv/bin/python'):
        subprocess.run([uv, 'venv', '-q', '--python', '3.12', f'{d}/venv'], check=True)
    subprocess.run([uv, 'pip', 'install', '-q', 'kokoro-onnx', 'soundfile'], check=True, env={**os.environ, 'VIRTUAL_ENV': f'{d}/venv'})
    base = 'https://github.com/thewh1teagle/kokoro-onnx/releases/download/model-files-v1.0'
    for f in ('kokoro-v1.0.onnx', 'voices-v1.0.bin'):
        if not os.path.exists(f'{d}/{f}') or os.path.getsize(f'{d}/{f}') < 1_000_000:
            print(f'Downloading {f}…')
            urllib.request.urlretrieve(f'{base}/{f}', f'{d}/{f}')
    print('Natural voice installed. Pick a voice in the dashboard: Settings → Jarvis voice.')


