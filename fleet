def dash_install(local=False):
    """Run the dashboard server at login (launchd) and publish it to your tailnet over HTTPS (tailscale serve)."""
    import plistlib
    dash_dir = os.path.join(os.path.dirname(FLEET), 'dashboard')
    node = shutil.which('node') or sys.exit('The dashboard needs Node.js 24+ (brew install node).')
    if not os.path.isdir(f'{dash_dir}/node_modules'):
        subprocess.run(['npm', 'ci'], cwd=dash_dir, check=True)
    if not os.path.exists(f'{dash_dir}/dist/index.html'):
        subprocess.run(['npm', 'run', 'build'], cwd=dash_dir, check=True)
    cfg = config()
    if not cfg.get('cwd'):  # where dashboard-started agents run unless you pick a folder: here
        cfg['cwd'] = os.getcwd()
        with open(f'{FLEET_DIR}/config.json', 'w') as f:
            json.dump(cfg, f)
        print(f'Agents started from the dashboard will run in {cfg["cwd"]} (change "cwd" in {FLEET_DIR}/config.json).')
    env = {'PATH': f'{os.path.dirname(node)}:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:{HOME}/.local/bin'}
    if 'FLEET_DIR' in os.environ:
        env['FLEET_DIR'] = FLEET_DIR
    os.makedirs(os.path.dirname(PLIST), exist_ok=True)
    with open(PLIST, 'wb') as f:
        plistlib.dump({'Label': LABEL, 'ProgramArguments': [node, f'{dash_dir}/server/index.ts'], 'WorkingDirectory': dash_dir,
                       'RunAtLoad': True, 'KeepAlive': True, 'EnvironmentVariables': env,
                       'StandardOutPath': f'{FLEET_DIR}/server.log', 'StandardErrorPath': f'{FLEET_DIR}/server.log'}, f)
    domain = f'gui/{os.getuid()}'
    subprocess.run(['launchctl', 'bootout', f'{domain}/{LABEL}'], capture_output=True)  # restart if already loaded
    subprocess.run(['launchctl', 'bootstrap', domain, PLIST], check=True)
    print(f'Dashboard running at login: http://127.0.0.1:{cfg["port"]}/?key={cfg["key"]}')
    ts = None if local else tailscale()
    if not ts:
        return print('Not published to Tailscale (--local, or Tailscale not found).' if local or not tailscale() else '')
    current = json.loads(out(ts, 'serve', 'status', '--json') or '{}')
    if current and f'127.0.0.1:{cfg["port"]}' not in json.dumps(current):
        return print('Tailscale serve already has another config, so it was left alone.\n'
                     f'Publish the dashboard yourself, e.g.: tailscale serve --bg --https=8443 {cfg["port"]}')
    if subprocess.run([ts, 'serve', '--bg', str(cfg['port'])]).returncode:
        return print('tailscale serve failed. If it mentions HTTPS, enable HTTPS certificates in the Tailscale admin '
                     'console (DNS page), then run fleet dash install again.')
    host = json.loads(out(ts, 'status', '--json'))['Self']['DNSName'].rstrip('.')
    print(f'On your phone (Safari → Share → Add to Home Screen): https://{host}/?key={cfg["key"]}')


